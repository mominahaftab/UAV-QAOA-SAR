# UAV-QAOA-SAR Environment Configuration

# Backend API Configuration
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration
# Local development default: SQLite
DATABASE_URL=sqlite:///./uav_qaoa_sar.db
# Production example: PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/uav_qaoa_sar

# Optimization & Solver Settings
DEFAULT_K_COVERAGE=2
DEFAULT_QAOA_REPS=2
MAX_WAYPOINTS=24
QAOA_SHOTS=2048
AER_SIMULATOR_METHOD=statevector

# Frontend Environment (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1

